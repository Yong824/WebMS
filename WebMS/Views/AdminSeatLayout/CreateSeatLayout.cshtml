@model WebMS.Models.ViewModels.Admin.LayoutEditorViewModel
@{
    ViewBag.Title = Model.IsNew ? "Create Template" : "Edit Template";
}

@section head {
    <link rel="stylesheet" href="~/css/seat-layout-editor.css" asp-append-version="true" />
}

<div class="editor-wrap">
    <!-- ─── SIDEBAR ─── -->
    <div class="sidebar">
        <h5>Layout Name</h5>
        <input id="layoutName" class="form-control mb-2" value="@Model.Name" placeholder="Layout name" />

        <h5 class="mt-3">Grid Size</h5>
        <div class="d-flex gap-1 mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" id="btnAddRow">+ Row</button>
            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" id="btnAddCol">+ Col</button>
            <button type="button" class="btn btn-sm btn-outline-danger flex-fill" id="btnRemoveRow">- Row</button>
            <button type="button" class="btn btn-sm btn-outline-danger flex-fill" id="btnRemoveCol">- Col</button>
        </div>

        <h5 class="mt-3">Sections & Pricing</h5>
        <p class="text-muted small mb-2">Click the left-most column in the grid to assign sections to rows.</p>
        <div id="sectionList" class="mb-3"></div>

        <h5 class="mt-3">Palette</h5>
        <button type="button" class="btn btn-sm btn-dark palette-btn active" data-tool="Seat">Standard Seat</button>
        <button type="button" class="btn btn-sm btn-info palette-btn" data-tool="Seat" data-cat="OKU">OKU Seat</button>
        <button type="button" class="btn btn-sm btn-outline-dark palette-btn" data-tool="Screen">Screen</button>
        <button type="button" class="btn btn-sm btn-outline-secondary palette-btn" data-tool="Aisle">Aisle</button>
        <button type="button" class="btn btn-sm btn-success palette-btn" data-tool="Entrance">Entrance</button>
        <button type="button" class="btn btn-sm btn-warning palette-btn" data-tool="Exit">Exit</button>
        <button type="button" class="btn btn-sm btn-danger palette-btn" data-tool="Emergency_Exit">Emergency Exit</button>
        <button type="button" class="btn btn-sm btn-outline-success palette-btn" data-tool="Empty">Eraser (Empty)</button>
        @* TODO: Hall dropdown list for select the hall to select with the layout *@
    </div>

    <!-- ─── CANVAS ─── -->
    <div class="canvas-area">
        <div id="seatGrid" class="seat-grid"></div>
    </div>
</div>

<div class="d-flex justify-content-end p-3 border-top">
    <a href="/AdminSeatLayout" class="btn btn-secondary me-2">Cancel</a>
    <button type="button" class="btn btn-primary" id="btnSave">Save Template</button>
</div>

@Html.AntiForgeryToken()

@section foot {
    <script>
        window.SeatLayoutEditor = 
        {
            initialState: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })),
            saveUrl: '/AdminSeatLayout/Save',
            cancelUrl: '@(ViewBag.ReturnUrl ?? "/AdminSeatLayout")'
        };
    </script>

    <script src="/js/seat-layout-editor.js" asp-append-version="true"></script>
}
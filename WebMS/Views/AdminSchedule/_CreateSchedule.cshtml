@model WebMS.Models.ViewModels.Admin.CreateScheduleDto

<form asp-action="Create" asp-controller="Schedule" method="post" data-ajax-form>
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="HallId" />

    <div class="modal-header">
        <h5 class="modal-title">Schedule Movie for @ViewBag.HallName (@ViewBag.CinemaName)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <!-- Show general error (like cleaning buffer conflict) -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

        <div class="mb-3">
            <label asp-for="MovieId" class="form-label">Movie</label>
            <select asp-for="MovieId" asp-items="ViewBag.Movies" class="form-select">
                <option value="">-- Select Movie --</option>
            </select>
            <span asp-validation-for="MovieId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Showtime" class="form-label">Showtime</label>
            <input asp-for="Showtime" type="datetime-local" class="form-control" />
            <span asp-validation-for="Showtime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Format" class="form-label">Format</label>
            <select asp-for="Format" asp-items="Html.GetEnumSelectList<WebMS.Models.Enums.MovieFormat>()" class="form-select"></select>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Schedule</button>
    </div>
</form>
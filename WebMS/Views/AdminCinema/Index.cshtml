@* Admin Cinema Management Page *@

@{
    ViewBag.Title = "Cinema List";
}

@Html.Hidden("sort", "", new { form = "f" })
@Html.Hidden("dir", "", new { form = "f" })

@section head {
<style>
    :root { /*Default with light theme */
        --popup-bg: #fff;
        --popup-border: #bbb;
        --popup-box-shadow: inset 0px 0px 3px 2px rgba(0,0,0,0.1);
    }
    /* Dark Theme */
    [data-theme="dark"] {
        --popup-bg: #333333;
        --popup-border: #dddddd;
        --popup-box-shadow: inset 0px 0px 3px 2px rgba(255,255,255,0.2);
    }

    .hall-cell, .id-cell {
        position: relative;
        cursor: default;
    }

    .table .popup {
        background: #fff;
        border: inherit;
        padding: inherit;
        position: absolute;
        z-index: 1;
        white-space: nowrap;
        top: 50%;
        left: 100%;
        transform: translate(-5px, -50%);
        display: none;
        background-color: var(--popup-bg);
        border: 1px solid var(--popup-border);
        box-shadow: var(--popup-box-shadow);
    }

    .hall-cell .popup ul, .id-cell .popup ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .hall-cell:hover .popup, .id-cell:hover .popup {
        display: block;
    }

</style>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Cinemas</h2>
    <button type="button" data-modal-url="/AdminCinema/Create" data-modal-target="#cinemaModal" class="btn btn-primary" id="btnAddCinema">
        + Add New Cinema
    </button>
</div>

<form data-ajax="true" data-ajax-update="#target" data-ajax-loading="#loader" id="f">
    @Html.TextBox("name", "", new { type = "search", autofocus = "", data_trim = "" })
    <button>Search</button>
    <img src="/images/loader.gif" id="loader" style="display: none">
</form>

<div id="target">
    <partial name="_CinemaTable">
    @*
        TODO: 
            - ID just show combination of first 3 digit and last 3 digit
            - Paging Bar Styling
            - Merchant null default to appsettings
    *@
</div>

<!-- TODO: Bootstrap Modal Shell -->
<div class="modal fade" id="cinemaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="cinemaModalContent">
            <!-- Form will be loaded here via AJAX -->
        </div>
    </div>
</div>

@section foot {
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/cinema-editor.js" asp-append-version="true"></script>

    <script>
        let timer = null;

        $('#name').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 500);
        });
    </script>
    
}
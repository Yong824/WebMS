@model WebMS.Models.ViewModels.Admin.CreateMovieViewModel
@{
    ViewBag.Title = "Add New Movie";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Add New Movie</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
</div>

@* TODO: AJAX form *@
<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Director" class="form-label"></label>
            <input asp-for="Director" class="form-control" />
            <span asp-validation-for="Director" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ReleaseAt" class="form-label"></label>
            <input asp-for="ReleaseAt" type="date" class="form-control" />
            <span asp-validation-for="ReleaseAt" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Duration" class="form-label"></label>
            <input asp-for="Duration" type="number" class="form-control" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Rating" class="form-label"></label>
            <select asp-for="Rating" asp-items="Html.GetEnumSelectList<WebMS.Models.Enums.MovieRating>()" class="form-select"></select>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="BasePrice" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">RM</span>
                <input asp-for="BasePrice" type="number" step="0.01" class="form-control" />
            </div>
            <span asp-validation-for="BasePrice" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="MovieTypeId" class="form-label"></label>
            <select asp-for="MovieTypeId" asp-items="ViewBag.MovieTypes" class="form-select">
                <option value="">-- Select Movie Type --</option>
            </select>
            <span asp-validation-for="MovieTypeId" class="text-danger"></span>
            @if (!((SelectList)ViewBag.MovieTypes).Any())
            {
                <small class="text-danger">No movie types exist. Create one in the Movie Types admin page first.</small>
            }
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="TrailerPath" class="form-label"></label>
            <input asp-for="TrailerPath" class="form-control" placeholder="https://youtube.com/watch?v=..." />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Images" class="form-label"></label>
        <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
        <small class="text-muted">
            Upload one or more images. The first image will be the primary (cover) image.
            Order can be rearranged later from the movie edit page.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">Save Movie</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

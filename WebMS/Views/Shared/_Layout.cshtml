@* Layout file for customer view *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - BELLO Cinemas</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">

    @RenderSection("head", required: false)
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bello-header-footer py-3">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <img src="/images/general/bello_logo.png" alt="BELLO" style="height: 50px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="/"><i class="fa-solid fa-house"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#"><i class="fa-solid fa-video"></i>Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#"><i class="fa-solid fa-building"></i>Cinemas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#"><i class="fa-solid fa-utensils"></i>Food & Drinks</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#"><i class="fa-solid fa-right-to-bracket"></i>Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="#"><i class="fa-solid fa-user-plus"></i>Register</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @RenderSection("Hero", required: false)

    <div class="container mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bello-footer text-light pt-5 pb-2 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <img src="/images/bello_logo.png" alt="BELLO" style="height: 40px;" class="mb-3">
                    <p class="text-white-50 mt-2">Experience the ultimate cinematic journey. Premium entertainment and dining at your fingertips.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-warning mb-4 fw-bold">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none nav-link-custom d-inline-block">About Us</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none nav-link-custom d-inline-block">Contact Support</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none nav-link-custom d-inline-block">Terms & Conditions</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none nav-link-custom d-inline-block">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="text-warning mb-4 fw-bold">Follow Us</h5>
                    <div class="d-flex gap-4">
                        <a href="#" class="nav-link-custom fs-4"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="nav-link-custom fs-4"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="nav-link-custom fs-4"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="nav-link-custom fs-4"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary mt-1 mb-3">
            <div class="text-center text-white-50">
                <small>&copy; 2026 BELLO Cinemas. All Rights Reserved.</small>
            </div>
        </div>
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
